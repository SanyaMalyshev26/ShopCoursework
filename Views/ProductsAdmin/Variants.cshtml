@model ShopCoursework.Models.Product
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = $"Варианты: {Model.Name}";
    var currencyCulture = System.Globalization.CultureInfo.GetCultureInfo(Configuration["Store:Culture"] ?? "ru-RU");
}

<main class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <a href="/Admin/Products" class="btn btn-link px-0">← К товарам</a>
            <h2 class="mb-0">Варианты товара</h2>
            <p class="text-muted mb-0">@Model.Name</p>
        </div>
        <a href="/Admin/Products/Edit/@Model.Id" class="btn btn-outline-secondary">Изменить товар</a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive bg-white rounded shadow-sm p-3 mb-4">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Размер</th>
                    <th>Цвет</th>
                    <th>Цена</th>
                    <th>Остаток</th>
                    <th>Доступен</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var variant in Model.Variants)
                {
                    <tr>
                        <td>@variant.Sku</td>
                        <td>@variant.Size</td>
                        <td>@variant.Color</td>
                        <td>@Model.Price.ToString("C0", currencyCulture)</td>
                        <td>
                            <form method="post" action="/Admin/Products/@Model.Id/Variants/@variant.Id/Update"
                                  asp-antiforgery="true" class="d-flex align-items-center gap-2">
                                <input type="number" name="stock" value="@variant.Stock" min="0"
                                       class="form-control form-control-sm" style="max-width:100px" aria-label="Остаток">
                                <div class="form-check">
                                    <input type="checkbox" name="isActive" value="true" checked="@variant.IsActive"
                                           class="form-check-input" aria-label="Вариант доступен">
                                </div>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Сохранить</button>
                            </form>
                        </td>
                        <td>@(variant.IsActive && variant.Stock > 0 ? "В наличии" : "Нет в наличии")</td>
                        <td>
                            <form method="post" action="/Admin/Products/@Model.Id/Variants/@variant.Id/Delete"
                                  asp-antiforgery="true"
                                  onsubmit="return confirm('Удалить вариант @variant.Sku?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Variants.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Варианты ещё не добавлены.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <section class="bg-white rounded shadow-sm p-4" style="max-width:720px;">
        <h3 class="h5 mb-3">Добавить вариант</h3>
        <form method="post" action="/Admin/Products/@Model.Id/Variants" asp-antiforgery="true"
              class="row g-3">
            <div class="col-md-4">
                <label for="variantSku" class="form-label">SKU</label>
                <input id="variantSku" name="Sku" class="form-control" maxlength="64" required>
            </div>
            <div class="col-md-4">
                <label for="variantSize" class="form-label">Размер</label>
                <input id="variantSize" name="Size" class="form-control" maxlength="32"
                       placeholder="M" required>
            </div>
            <div class="col-md-4">
                <label for="variantColor" class="form-label">Цвет</label>
                <input id="variantColor" name="Color" class="form-control" maxlength="64"
                       placeholder="Чёрный" required>
            </div>
            <div class="col-md-4">
                <label for="variantStock" class="form-label">Начальный остаток</label>
                <input id="variantStock" name="Stock" type="number" class="form-control" min="0"
                       value="0" required>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">Добавить вариант</button>
            </div>
        </form>
    </section>
</main>
