@model ShopCoursework.Models.AdminProductsViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Админка: товары";
    var currencyCulture = System.Globalization.CultureInfo.GetCultureInfo(Configuration["Store:Culture"] ?? "ru-RU");
}

<main class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Товары</h2>
        <a href="/Admin/Products/Create" class="btn btn-primary">+ Добавить товар</a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <section class="row g-3 mb-4" aria-label="Состояние склада">
        <div class="col-sm-6">
            <div class="alert alert-warning mb-0">
                Низкий остаток (до @Model.LowStockThreshold шт.): <strong>@Model.LowStockVariantCount</strong> SKU
            </div>
        </div>
        <div class="col-sm-6">
            <div class="alert alert-danger mb-0">
                Нет в наличии: <strong>@Model.OutOfStockVariantCount</strong> активных SKU
            </div>
        </div>
    </section>

    <div class="table-responsive bg-white rounded shadow-sm p-3">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th style="width:70px;"></th>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Цена</th>
                    <th>Варианты / остаток</th>
                    <th>Рейтинг</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Products)
                {
                    <tr>
                        <td><img src="@p.ImageUrl" alt="" width="50" height="50" class="rounded" style="object-fit:cover"></td>
                        <td>@p.Id</td>
                        <td>@p.Name</td>
                        <td>@p.Price.ToString("C0", currencyCulture)</td>
                        <td>
                            <a href="/Admin/Products/@p.Id/Variants">@p.Variants.Count вариантов</a>
                            <span class="text-muted">· @p.Variants.Where(v => v.IsActive).Sum(v => v.Stock) шт.</span>
                            @{
                                var lowStockVariants = p.Variants
                                    .Where(variant => variant.IsActive &&
                                        variant.Stock > 0 &&
                                        variant.Stock <= Model.LowStockThreshold)
                                    .ToList();
                                var outOfStockVariants = p.Variants
                                    .Where(variant => variant.IsActive && variant.Stock == 0)
                                    .ToList();
                            }
                            @if (lowStockVariants.Count > 0)
                            {
                                <div class="small text-warning-emphasis">
                                    Мало: @string.Join(", ", lowStockVariants.Select(variant => $"{variant.Sku} ({variant.Stock})"))
                                </div>
                            }
                            @if (outOfStockVariants.Count > 0)
                            {
                                <div class="small text-danger">
                                    Нет: @string.Join(", ", outOfStockVariants.Select(variant => variant.Sku))
                                </div>
                            }
                            <br>
                            <a href="/Admin/Products/@p.Id/SizeGuides">Таблица размеров</a>
                        </td>
                        <td>@p.Rating.ToString("0.##", currencyCulture) ★</td>
                        <td class="text-end">
                            <a href="/Admin/Products/Edit/@p.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            <form method="post" action="/Admin/Products/Delete/@p.Id" asp-antiforgery="true" class="d-inline"
                                  onsubmit="return confirm('Удалить товар «@p.Name»?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>