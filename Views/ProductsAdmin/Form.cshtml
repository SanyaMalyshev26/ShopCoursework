@model ShopCoursework.Models.Product
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Новый товар" : "Редактирование товара";
    var action = isNew ? "/Admin/Products/Create" : $"/Admin/Products/Edit/{Model.Id}";
    var price = Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var rating = Model.Rating.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var currencyCulture = System.Globalization.CultureInfo.GetCultureInfo(Configuration["Store:Culture"] ?? "ru-RU");
}

<main class="container my-5" style="max-width:640px;">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <form method="post" action="@action" asp-antiforgery="true" class="row g-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="col-12">
            <label class="form-label">Название</label>
            <input type="text" class="form-control" name="Name" value="@Model.Name" required>
        </div>

        <div class="col-12">
            <label class="form-label">Описание</label>
            <textarea class="form-control" name="Description" rows="3">@Model.Description</textarea>
        </div>

        <div class="col-md-6">
            <label class="form-label">Цена, @currencyCulture.NumberFormat.CurrencySymbol</label>
            <input type="number" step="0.01" min="0" class="form-control" name="Price" value="@price" required>
        </div>

        <div class="col-md-6">
            <label class="form-label">Рейтинг (0-5)</label>
            <input type="number" step="0.1" min="0" max="5" class="form-control" name="Rating" value="@rating">
        </div>

        <div class="col-12">
            <label class="form-label">Ссылка на картинку</label>
            <input type="text" class="form-control" name="ImageUrl" value="@Model.ImageUrl"
                   placeholder="https://placehold.co/300x250">
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Сохранить</button>
            @if (!isNew)
            {
                <a href="/Admin/Products/@Model.Id/Variants" class="btn btn-outline-primary">Варианты и остатки</a>
            }
            <a href="/Admin/Products" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </form>
</main>