@using System.Globalization
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model List<ShopCoursework.Models.Product>
@{
    ViewData["Title"] = "Главная";
    var currencyCulture = CultureInfo.GetCultureInfo(Configuration["Store:Culture"] ?? "ru-RU");
}

<section class="hero text-center text-white d-flex align-items-center">
    <div class="container">
        <h1 class="display-4 fw-bold">Лучшие вещи по лучшим ценам</h1>
        <p class="lead">Быстрая доставка, гарантия качества, удобный личный кабинет</p>
        <a href="#catalog" class="btn btn-light btn-lg mt-3">Перейти в каталог</a>
    </div>
</section>

<section id="catalog" class="container my-5">
    <h2 class="mb-4">Популярные товары</h2>

    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 product-card">
                    <img src="@p.ImageUrl" class="card-img-top" alt="@p.Name">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@p.Name</h5>
                        <p class="card-text text-muted small">@p.Rating.ToString("0.##", currencyCulture) ★</p>
                        <p class="fw-bold fs-5 mt-auto mb-2">@p.Price.ToString("C0", currencyCulture)</p>
                        <button class="btn btn-primary w-100 add-to-cart"
                                data-id="@p.Id"
                                data-name="@p.Name"
                                data-price="@p.Price.ToString(CultureInfo.InvariantCulture)">
                            В корзину
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</section>