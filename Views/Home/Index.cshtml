@using System.Globalization
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model List<ShopCoursework.Models.Product>
@{
    ViewData["Title"] = "Главная";
    var currencyCulture = CultureInfo.GetCultureInfo(Configuration["Store:Culture"] ?? "ru-RU");
}

<section class="hero text-center text-white d-flex align-items-center">
    <div class="container">
        <h1 class="display-4 fw-bold">Лучшие вещи по лучшим ценам</h1>
        <p class="lead">Быстрая доставка, гарантия качества, удобный личный кабинет</p>
        <a href="#catalog" class="btn btn-light btn-lg mt-3">Перейти в каталог</a>
    </div>
</section>

<section id="catalog" class="container my-5">
    <h2 class="mb-4">Популярные товары</h2>

    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 product-card">
                    <img src="@p.ImageUrl" class="card-img-top" alt="@p.Name">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                            <a class="text-decoration-none text-dark" href="/Products/@p.Id">@p.Name</a>
                        </h5>
                        <a href="/Products/@p.Id" class="btn btn-outline-secondary btn-sm mb-2">Подробнее о товаре</a>
                        <p class="card-text text-muted small">@p.Rating.ToString("0.##", currencyCulture) ★</p>
                        <p class="fw-bold fs-5 mt-auto mb-2">@p.Price.ToString("C0", currencyCulture)</p>
                        <label class="form-label small mt-2" for="variant-@p.Id">Размер и цвет</label>
                        <select id="variant-@p.Id" class="form-select variant-select mb-2">
                            <option value="">Выберите вариант</option>
                            @foreach (var variant in p.Variants.OrderBy(v => v.Size).ThenBy(v => v.Color))
                            {
                                <option value="@variant.Id" data-stock="@variant.Stock"
                                        data-size="@variant.Size" data-color="@variant.Color"
                                        disabled="@(variant.Stock == 0)">
                                    @variant.Size · @variant.Color — @(variant.Stock > 0 ? $"В наличии: {variant.Stock}" : "Нет в наличии")
                                </option>
                            }
                        </select>
                        <details class="mb-2">
                            <summary class="small">Подобрать размер</summary>
                            <form class="size-recommendation-form mt-2"
                                  data-url="/Products/@p.Id/SizeRecommendation">
                                <p class="small text-muted mb-2">
                                    Введите известные мерки в сантиметрах. Данные не сохраняются.
                                </p>
                                <label class="form-label small mb-1" for="chest-@p.Id">Грудь, см</label>
                                <input id="chest-@p.Id" class="form-control form-control-sm mb-2"
                                       type="number" min="30" max="200" step="0.1" data-measure="chest">
                                <label class="form-label small mb-1" for="waist-@p.Id">Талия, см</label>
                                <input id="waist-@p.Id" class="form-control form-control-sm mb-2"
                                       type="number" min="30" max="200" step="0.1" data-measure="waist">
                                <label class="form-label small mb-1" for="hips-@p.Id">Бёдра, см</label>
                                <input id="hips-@p.Id" class="form-control form-control-sm mb-2"
                                       type="number" min="30" max="200" step="0.1" data-measure="hips">
                                <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                                    Узнать размер
                                </button>
                                <div class="size-recommendation-result small mt-2" role="status" aria-live="polite"></div>
                            </form>
                        </details>
                        <button class="btn btn-primary w-100 add-to-cart" disabled
                                data-id="@p.Id"
                                data-name="@p.Name"
                                data-price="@p.Price.ToString(CultureInfo.InvariantCulture)">
                            В корзину
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/size-recommendation.js" asp-append-version="true"></script>
}