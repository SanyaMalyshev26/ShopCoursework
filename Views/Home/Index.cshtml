@using System.Globalization
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model ShopCoursework.Models.CatalogViewModel
@{
    ViewData["Title"] = "Главная";
    var currencyCulture = CultureInfo.GetCultureInfo(Configuration["Store:Culture"] ?? "ru-RU");
}

<section class="hero text-center text-white d-flex align-items-center">
    <div class="container">
        <h1 class="display-4 fw-bold">Лучшие вещи по лучшим ценам</h1>
        <p class="lead">Быстрая доставка, гарантия качества, удобный личный кабинет</p>
        <a href="#catalog" class="btn btn-light btn-lg mt-3">Перейти в каталог</a>
    </div>
</section>

<section id="catalog" class="container my-5">
    <h2 class="mb-4">Каталог товаров</h2>

    <form method="get" action="/" class="row g-3 align-items-end mb-4">
        <div class="col-12 col-md-4">
            <label for="catalogSearch" class="form-label">Поиск</label>
            <input id="catalogSearch" name="search" value="@Model.Search" maxlength="120"
                   class="form-control" placeholder="Название или описание">
        </div>
        <div class="col-6 col-md-2">
            <label for="catalogSize" class="form-label">Размер</label>
            <select id="catalogSize" name="size" class="form-select">
                <option value="">Любой</option>
                @foreach (var size in Model.Sizes)
                {
                    <option value="@size" selected="@(Model.Size.Equals(size, StringComparison.OrdinalIgnoreCase))">@size</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label for="catalogSort" class="form-label">Сортировка</label>
            <select id="catalogSort" name="sort" class="form-select">
                <option value="featured" selected="@(Model.Sort == "featured")">По умолчанию</option>
                <option value="price-asc" selected="@(Model.Sort == "price-asc")">Сначала дешевле</option>
                <option value="price-desc" selected="@(Model.Sort == "price-desc")">Сначала дороже</option>
                <option value="rating" selected="@(Model.Sort == "rating")">По рейтингу</option>
            </select>
        </div>
        <div class="col-12 col-md-3">
            <div class="form-check mb-2">
                <input id="inStockOnly" name="inStockOnly" value="true" type="checkbox"
                       class="form-check-input" checked="@Model.InStockOnly">
                <label for="inStockOnly" class="form-check-label">Только в наличии</label>
            </div>
            <button type="submit" class="btn btn-primary">Показать</button>
            <a href="/#catalog" class="btn btn-outline-secondary">Сбросить</a>
        </div>
    </form>

    <div class="row g-4">
        @foreach (var p in Model.Products)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 product-card">
                    <img src="@p.ImageUrl" class="card-img-top" alt="@p.Name">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                            <a class="text-decoration-none text-dark" href="/Products/@p.Id">@p.Name</a>
                        </h5>
                        <a href="/Products/@p.Id" class="btn btn-outline-secondary btn-sm mb-2">Подробнее о товаре</a>
                        <p class="card-text text-muted small">@p.Rating.ToString("0.##", currencyCulture) ★</p>
                        <p class="fw-bold fs-5 mt-auto mb-2">@p.Price.ToString("C0", currencyCulture)</p>
                        <label class="form-label small mt-2" for="variant-@p.Id">Размер и цвет</label>
                        <select id="variant-@p.Id" class="form-select variant-select mb-2">
                            <option value="">Выберите вариант</option>
                            @foreach (var variant in p.Variants.OrderBy(v => v.Size).ThenBy(v => v.Color))
                            {
                                <option value="@variant.Id" data-stock="@variant.Stock"
                                        data-size="@variant.Size" data-color="@variant.Color"
                                        disabled="@(variant.Stock == 0)">
                                    @variant.Size · @variant.Color — @(variant.Stock > 0 ? $"В наличии: {variant.Stock}" : "Нет в наличии")
                                </option>
                            }
                        </select>
                        <details class="mb-2">
                            <summary class="small">Подобрать размер</summary>
                            <form class="size-recommendation-form mt-2"
                                  data-url="/Products/@p.Id/SizeRecommendation">
                                <p class="small text-muted mb-2">
                                    Введите известные мерки в сантиметрах. Данные не сохраняются.
                                </p>
                                <label class="form-label small mb-1" for="chest-@p.Id">Грудь, см</label>
                                <input id="chest-@p.Id" class="form-control form-control-sm mb-2"
                                       type="number" min="30" max="200" step="0.1" data-measure="chest">
                                <label class="form-label small mb-1" for="waist-@p.Id">Талия, см</label>
                                <input id="waist-@p.Id" class="form-control form-control-sm mb-2"
                                       type="number" min="30" max="200" step="0.1" data-measure="waist">
                                <label class="form-label small mb-1" for="hips-@p.Id">Бёдра, см</label>
                                <input id="hips-@p.Id" class="form-control form-control-sm mb-2"
                                       type="number" min="30" max="200" step="0.1" data-measure="hips">
                                <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                                    Узнать размер
                                </button>
                                <div class="size-recommendation-result small mt-2" role="status" aria-live="polite"></div>
                            </form>
                        </details>
                        <button class="btn btn-primary w-100 add-to-cart" disabled
                                data-id="@p.Id"
                                data-name="@p.Name"
                                data-price="@p.Price.ToString(CultureInfo.InvariantCulture)">
                            В корзину
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
    @if (Model.Products.Count == 0)
    {
        <div class="alert alert-info mt-4" role="status">
            По выбранным условиям товары не найдены. Измените фильтры или сбросьте их.
        </div>
    }
    else if (Model.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Страницы каталога">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-search="@Model.Search"
                       asp-route-size="@Model.Size"
                       asp-route-inStockOnly="@(Model.InStockOnly ? "true" : null)"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@(Model.Page - 1)"
                       aria-label="Предыдущая страница">Назад</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Страница @Model.Page из @Model.TotalPages</span>
                </li>
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-search="@Model.Search"
                       asp-route-size="@Model.Size"
                       asp-route-inStockOnly="@(Model.InStockOnly ? "true" : null)"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@(Model.Page + 1)"
                       aria-label="Следующая страница">Далее</a>
                </li>
            </ul>
        </nav>
    }
</section>

@section Scripts {
    <script src="~/js/size-recommendation.js" asp-append-version="true"></script>
}