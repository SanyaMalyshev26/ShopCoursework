@model ShopCoursework.Models.ApplicationUser
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Личный кабинет";
    var currencyCulture = System.Globalization.CultureInfo.GetCultureInfo(Configuration["Store:Culture"] ?? "ru-RU");
}

<main class="container my-5">
        @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">Личный кабинет</h2>
        <p class="text-muted mb-0">Здравствуйте, <strong>@Model.FirstName @Model.LastName</strong>!</p>
    </div>
    <form method="post" asp-controller="Account" asp-action="Logout">
        <button type="submit" class="btn btn-outline-danger">Выйти</button>
    </form>
</div>

    <ul class="nav nav-tabs" id="accountTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab">👤 Профиль</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="orders-tab" data-bs-toggle="tab" data-bs-target="#orders" type="button" role="tab">📦 Мои заказы</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="addresses-tab" data-bs-toggle="tab" data-bs-target="#addresses" type="button" role="tab">📍 Адреса доставки</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="stock-notifications-tab" data-bs-toggle="tab"
                    data-bs-target="#stock-notifications" type="button" role="tab">
                🔔 Поступления
            </button>
        </li>
    </ul>

    <div class="tab-content bg-white p-4 border border-top-0 rounded-bottom shadow-sm" id="accountTabsContent">

        <!-- ПРОФИЛЬ -->
        <div class="tab-pane fade show active" id="profile" role="tabpanel">
            <form id="profileForm" class="row g-3" method="post" asp-action="UpdateProfile">
                <div class="col-md-6">
                    <label class="form-label">Имя</label>
                    <input type="text" class="form-control" name="firstName" value="@Model.FirstName">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Фамилия</label>
                    <input type="text" class="form-control" name="lastName" value="@Model.LastName">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" name="email" value="@Model.Email" readonly>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Телефон</label>
                    <input type="tel" class="form-control" name="phone" value="@Model.PhoneNumber">
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Сохранить изменения</button>
                </div>
            </form>

            <hr class="my-4">

            <h5 class="mb-3">Смена пароля</h5>
            <form id="passwordForm" class="row g-3" method="post" asp-action="ChangePassword">
                <div class="col-md-4">
                    <label class="form-label">Текущий пароль</label>
                    <input type="password" class="form-control" name="currentPassword">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Новый пароль</label>
                    <input type="password" class="form-control" name="newPassword">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Повторите новый</label>
                    <input type="password" class="form-control" name="confirmPassword">
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-outline-primary">Изменить пароль</button>
                </div>
            </form>
        </div>

        <!-- ЗАКАЗЫ -->
        <div class="tab-pane fade" id="orders" role="tabpanel">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>№ заказа</th>
                            <th>Дата</th>
                            <th>Сумма</th>
                            <th>Статус</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in (List<ShopCoursework.Models.Order>)ViewBag.Orders)
{
    <tr>
        <td>
            #@o.Id
            @if (o.Items.Count > 0)
            {
                <ul class="small text-muted mb-0 ps-3">
                    @foreach (var item in o.Items)
                    {
                        <li>
                            @(item.ProductName ?? item.Product?.Name)
                            @if (!string.IsNullOrEmpty(item.VariantSize) || !string.IsNullOrEmpty(item.VariantColor))
                            {
                                <span>— @item.VariantSize @item.VariantColor</span>
                            }
                            × @item.Quantity
                        </li>
                    }
                </ul>
            }
            @if (!string.IsNullOrEmpty(o.ShippingCity) && !string.IsNullOrEmpty(o.ShippingStreet))
            {
                <div class="small text-muted">Доставка: @o.ShippingAddressTitle, г. @o.ShippingCity, @o.ShippingStreet</div>
            }
        </td>
        <td>@o.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
        <td>@o.Total.ToString("C0", currencyCulture)</td>
        <td>
            <span class="badge bg-secondary">@o.Status</span>
            <div class="small text-muted mt-1">@o.PaymentMethod · @o.PaymentStatus</div>
            @if (o.History.Count > 0)
            {
                <details class="mt-2">
                    <summary class="small">История (@o.History.Count)</summary>
                    <ul class="small text-muted ps-3 mt-2 mb-0">
                        @foreach (var entry in o.History)
                        {
                            <li>
                                @entry.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") —
                                @entry.EventType: @entry.Status · @entry.PaymentStatus
                            </li>
                        }
                    </ul>
                </details>
            }
        </td>
        <td>
            @if (o.Status == ShopCoursework.Models.OrderStatuses.New ||
                 o.Status == ShopCoursework.Models.OrderStatuses.Confirmed)
            {
                <form method="post" asp-action="CancelOrder" asp-route-id="@o.Id"
                      onsubmit="return confirm('Отменить заказ #@o.Id?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Отменить</button>
                </form>
            }
        </td>
    </tr>
}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="stock-notifications" role="tabpanel">
            @{
                var stockNotifications = (List<ShopCoursework.Models.StockNotification>)ViewBag.StockNotifications;
            }
            <h5 class="mb-3">Размеры, за которыми слежу</h5>
            @if (stockNotifications.Count == 0)
            {
                <p class="text-muted">
                    Подписок пока нет. На странице товара можно подписаться на отсутствующий размер.
                </p>
            }
            else
            {
                <div class="list-group">
                    @foreach (var notification in stockNotifications)
                    {
                        var currentStock = notification.Product?.Variants
                            .Where(variant => string.Equals(
                                variant.Size,
                                notification.Size,
                                StringComparison.OrdinalIgnoreCase))
                            .Sum(variant => variant.Stock) ?? 0;
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-start gap-3">
                                <div>
                                    <a href="/Products/@notification.ProductId" class="fw-semibold">
                                        @notification.Product?.Name
                                    </a>
                                    <div>Размер @notification.Size</div>
                                    @if (notification.NotifiedAt.HasValue)
                                    {
                                        <small class="text-success">
                                            Поступление было @notification.NotifiedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm").
                                            @if (currentStock > 0)
                                            {
                                                <span>Сейчас в наличии: @currentStock шт.</span>
                                            }
                                            else
                                            {
                                                <span>Сейчас размер снова закончился.</span>
                                            }
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Ожидаем поступления.</small>
                                    }
                                </div>
                                <form method="post" asp-action="DeleteStockNotification"
                                      asp-route-id="@notification.Id">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Убрать</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- АДРЕСА -->
                <div class="tab-pane fade" id="addresses" role="tabpanel">
            @{
                var addresses = (List<ShopCoursework.Models.Address>)ViewBag.Addresses;
            }

            @if (addresses.Count == 0)
            {
                <p class="text-muted">У вас пока нет адресов. Добавьте первый ниже.</p>
            }

            <div class="row g-3 mb-4">
                @foreach (var a in addresses)
                {
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="d-flex justify-content-between">
                                <strong>@a.Title</strong>
                                @if (a.IsDefault)
                                {
                                    <span class="badge bg-primary">По умолчанию</span>
                                }
                            </div>
                            <p class="mb-1 mt-2">г. @a.City, @a.Street</p>
                            <small class="text-muted">@Model.FirstName @Model.LastName @Model.PhoneNumber</small>
                            <div class="mt-3">
                                <form method="post" asp-action="DeleteAddress" asp-route-id="@a.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <h6 class="mb-3">Добавить адрес</h6>
            <form id="addressForm" class="row g-3" method="post" asp-action="AddAddress">
                <div class="col-md-6">
                    <input type="text" class="form-control" name="title" placeholder="Название (например, Домашний)">
                </div>
                <div class="col-md-6">
                    <input type="text" class="form-control" name="city" placeholder="Город" required>
                </div>
                <div class="col-12">
                    <input type="text" class="form-control" name="street" placeholder="Улица, дом, квартира" required>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Добавить</button>
                </div>
            </form>
        </div>

    </div>
</main>

@section Scripts {
    <script>
        if (window.location.hash === '#addresses') {
            bootstrap.Tab.getOrCreateInstance(document.getElementById('addresses-tab')).show();
        }
        if (window.location.hash === '#stock-notifications') {
            bootstrap.Tab.getOrCreateInstance(document.getElementById('stock-notifications-tab')).show();
        }
    </script>
}