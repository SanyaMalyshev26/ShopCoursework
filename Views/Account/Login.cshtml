@model ShopCoursework.Models.LoginViewModel
@{
    ViewData["Title"] = "Вход";
}

<main class="container my-5" style="max-width:480px;">
    <h2 class="mb-4">Вход</h2>

    <form method="post" asp-action="Login">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label class="form-label" asp-for="Email">Email</label>
            <input class="form-control" asp-for="Email">
            <span class="text-danger" asp-validation-for="Email"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Password">Пароль</label>
            <input class="form-control" asp-for="Password">
            <span class="text-danger" asp-validation-for="Password"></span>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" asp-for="RememberMe">
            <label class="form-check-label" asp-for="RememberMe">Запомнить меня</label>
        </div>

        <button type="submit" class="btn btn-primary w-100">Войти</button>
        <p class="mt-3 text-center">Нет аккаунта? <a asp-action="Register">Зарегистрироваться</a></p>
    </form>
</main>