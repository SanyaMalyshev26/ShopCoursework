@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Корзина";
    var currencyCode = Configuration["Store:CurrencyCode"] ?? "RUB";
    var currencyCulture = System.Globalization.CultureInfo.GetCultureInfo(Configuration["Store:Culture"] ?? "ru-RU");
}

<main class="container my-5" data-currency-code="@currencyCode" data-currency-culture="@currencyCulture.Name">
    @Html.AntiForgeryToken()
    <h2 class="mb-4">Корзина</h2>

    <!-- Пустая корзина -->
    <div id="emptyCart" class="text-center py-5 d-none">
        <p class="fs-4">🛒 Ваша корзина пуста</p>
        <a href="/" class="btn btn-primary">Перейти к покупкам</a>
    </div>

    <!-- Контент корзины -->
    <div id="cartContent" class="row g-4">

        <div class="col-lg-8">
            <div class="table-responsive bg-white rounded shadow-sm p-3">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Товар</th>
                            <th class="text-center" style="width:140px;">Кол-во</th>
                            <th class="text-end" style="width:120px;">Цена</th>
                            <th class="text-end" style="width:120px;">Сумма</th>
                            <th style="width:50px;"></th>
                        </tr>
                    </thead>
                    <tbody id="cartTableBody"></tbody>
                </table>
            </div>
            <a href="/" class="btn btn-link px-0 mt-3">← Продолжить покупки</a>
        </div>

        <div class="col-lg-4">
            <div class="bg-white rounded shadow-sm p-4">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var addresses = ViewBag.Addresses as List<ShopCoursework.Models.Address> ?? new();
                    if (addresses.Count > 0)
                    {
                        <div class="mb-4">
                            <label for="deliveryAddressId" class="form-label fw-semibold">Адрес доставки</label>
                            <select id="deliveryAddressId" class="form-select">
                                @foreach (var address in addresses)
                                {
                                    <option value="@address.Id" selected="@address.IsDefault">
                                        @address.Title — г. @address.City, @address.Street
                                    </option>
                                }
                            </select>
                            <a class="small" href="/Account/Index#addresses">Управлять адресами</a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            Чтобы оформить заказ, сначала
                            <a href="/Account/Index#addresses">добавьте адрес доставки в личном кабинете</a>.
                        </div>
                    }
                }
                <div class="mb-4">
                    <div class="form-label fw-semibold mb-1">Оплата</div>
                    <div>@ShopCoursework.Models.PaymentMethods.CashOnDelivery</div>
                    <small class="text-muted">Оплатите заказ курьеру при получении. Онлайн-списания нет.</small>
                </div>
                <h5 class="mb-3">Итого</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Товаров</span>
                    <span id="totalItems">0</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Сумма</span>
                    <span id="subtotal">@(0m.ToString("C0", currencyCulture))</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Доставка</span>
                    <span id="delivery">Бесплатно</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
                    <span>К оплате</span>
                    <span id="grandTotal">@(0m.ToString("C0", currencyCulture))</span>
                </div>
                <button class="btn btn-primary w-100 btn-lg" id="checkoutBtn"
                        disabled="@(User.Identity?.IsAuthenticated == true &&
                                   (ViewBag.Addresses as List<ShopCoursework.Models.Address> ?? new()).Count == 0)">
                    Оформить заказ
                </button>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/cart.js" asp-append-version="true"></script>
}