@model ShopCoursework.Models.AdminOrdersViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Админка: заказы";
    var currencyCulture = System.Globalization.CultureInfo.GetCultureInfo(Configuration["Store:Culture"] ?? "ru-RU");
}

<main class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="mb-0">Заказы</h2>
        <a href="/Admin/Products" class="btn btn-outline-secondary">К товарам и остаткам</a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning">@TempData["Error"]</div>
    }

    <section class="row g-3 mb-4" aria-label="Сводка по заказам">
        <div class="col-sm-4">
            <div class="alert alert-primary mb-0">
                Новые заказы: <strong><span id="newOrderCount">@Model.NewOrderCount</span></strong>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="alert alert-info mb-0">
                В обработке: <strong><span id="processingOrderCount">@Model.ProcessingOrderCount</span></strong>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="alert alert-warning mb-0">
                Ожидают оплаты: <strong><span id="awaitingPaymentCount">@Model.AwaitingPaymentCount</span></strong>
            </div>
        </div>
    </section>

    <form method="get" action="/Admin/Orders" class="row g-3 align-items-end mb-2">
        <div class="col-12 col-md-3">
            <label for="orderStatus" class="form-label">Статус заказа</label>
            <select id="orderStatus" name="status" class="form-select">
                <option value="">Все статусы</option>
                @foreach (var status in ShopCoursework.Models.AdminOrdersViewModel.StatusOptions)
                {
                    <option value="@status" selected="@(Model.Status == status)">@status</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-3">
            <label for="paymentStatus" class="form-label">Оплата</label>
            <select id="paymentStatus" name="paymentStatus" class="form-select">
                <option value="">Любой статус оплаты</option>
                @foreach (var paymentStatus in ShopCoursework.Models.AdminOrdersViewModel.PaymentStatusOptions)
                {
                    <option value="@paymentStatus" selected="@(Model.PaymentStatus == paymentStatus)">@paymentStatus</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-4">
            <label for="orderSearch" class="form-label">Номер заказа или email</label>
            <input id="orderSearch" name="search" value="@Model.Search" maxlength="120" class="form-control">
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Найти</button>
            <a href="/Admin/Orders" class="btn btn-outline-secondary">Сбросить</a>
        </div>
    </form>
    <div class="mb-4">
        <a asp-controller="OrdersAdmin" asp-action="Csv"
           asp-route-status="@Model.Status"
           asp-route-paymentStatus="@Model.PaymentStatus"
           asp-route-search="@Model.Search"
           class="btn btn-outline-secondary">Скачать отфильтрованные заказы CSV</a>
    </div>

    @if (Model.Orders.Count == 0)
    {
        <div class="alert alert-info">Заказов по выбранным условиям нет.</div>
    }
    else
    {
        <div class="table-responsive bg-white rounded shadow-sm p-3">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Заказ</th>
                        <th>Покупатель</th>
                        <th>Состав</th>
                        <th>Сумма</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>
                                <strong>#@order.Id</strong>
                                <br>
                                <small class="text-muted">@order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                            </td>
                            <td>
                                @order.User?.FirstName @order.User?.LastName
                                <br>
                                <small class="text-muted">@order.User?.Email</small>
                            </td>
                            <td>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var item in order.Items)
                                    {
                                        <li class="mb-1">
                                            @(item.ProductName ?? item.Product?.Name ?? "Товар удалён")
                                            @if (!string.IsNullOrEmpty(item.VariantSku))
                                            {
                                                <small class="text-muted">(@item.VariantSku)</small>
                                            }
                                            @if (!string.IsNullOrEmpty(item.VariantSize) ||
                                                 !string.IsNullOrEmpty(item.VariantColor))
                                            {
                                                <small class="text-muted">— @item.VariantSize @item.VariantColor</small>
                                            }
                                            <span>× @item.Quantity · @((item.UnitPrice * item.Quantity).ToString("C0", currencyCulture))</span>
                                        </li>
                                    }
                                </ul>
                                @if (!string.IsNullOrEmpty(order.ShippingCity) &&
                                     !string.IsNullOrEmpty(order.ShippingStreet))
                                {
                                    <div class="small text-muted mt-2">
                                        Доставка: @order.ShippingAddressTitle, г. @order.ShippingCity, @order.ShippingStreet
                                    </div>
                                }
                            </td>
                            <td class="text-nowrap">
                                @order.Total.ToString("C0", currencyCulture)
                                <div class="small text-muted">@order.PaymentMethod</div>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@order.Status</span>
                                <div class="small text-muted mt-1">@order.PaymentStatus</div>
                                @if (order.History.Count > 0)
                                {
                                    <details class="mt-2">
                                        <summary class="small">История (@order.History.Count)</summary>
                                        <ul class="small text-muted ps-3 mt-2 mb-0">
                                            @foreach (var entry in order.History)
                                            {
                                                <li>
                                                    @entry.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") —
                                                    @entry.EventType: @entry.Status · @entry.PaymentStatus
                                                </li>
                                            }
                                        </ul>
                                    </details>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    @if (order.Status == OrderStatuses.New)
                                    {
                                        <form method="post" action="/Admin/Orders/@order.Id/Confirm" asp-antiforgery="true">
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Подтвердить</button>
                                        </form>
                                    }
                                    @if (order.Status == OrderStatuses.Confirmed)
                                    {
                                        <form method="post" action="/Admin/Orders/@order.Id/Ship" asp-antiforgery="true">
                                            <button type="submit" class="btn btn-sm btn-outline-success">Отправить</button>
                                        </form>
                                    }
                                    @if (order.Status == OrderStatuses.Shipped)
                                    {
                                        <form method="post" action="/Admin/Orders/@order.Id/Deliver" asp-antiforgery="true">
                                            <button type="submit" class="btn btn-sm btn-outline-success">Отметить доставленным</button>
                                        </form>
                                    }
                                    @if (order.Status == OrderStatuses.Delivered &&
                                         order.PaymentMethod == PaymentMethods.CashOnDelivery &&
                                         order.PaymentStatus == PaymentStatuses.Pending)
                                    {
                                        <form method="post" action="/Admin/Orders/@order.Id/MarkPaid" asp-antiforgery="true">
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Отметить оплату полученной</button>
                                        </form>
                                    }
                                    @if (order.Status == OrderStatuses.New || order.Status == OrderStatuses.Confirmed)
                                    {
                                        <form method="post" action="/Admin/Orders/@order.Id/Cancel" asp-antiforgery="true"
                                              onsubmit="return confirm('Отменить заказ #@order.Id и вернуть его остатки на склад?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Отменить</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Страницы заказов">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-status="@Model.Status"
                       asp-route-paymentStatus="@Model.PaymentStatus"
                       asp-route-search="@Model.Search"
                       asp-route-page="@(Model.Page - 1)"
                       aria-label="Предыдущая страница">Назад</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Страница @Model.Page из @Model.TotalPages</span>
                </li>
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-status="@Model.Status"
                       asp-route-paymentStatus="@Model.PaymentStatus"
                       asp-route-search="@Model.Search"
                       asp-route-page="@(Model.Page + 1)"
                       aria-label="Следующая страница">Далее</a>
                </li>
            </ul>
        </nav>
    }
</main>
